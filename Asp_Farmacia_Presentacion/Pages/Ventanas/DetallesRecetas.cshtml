@page
@model DetallesRecetasModel
@{
    ViewData["Title"] = "Detalles de Recetas";
}
<form method="post" enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Detalles de Recetas</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />
            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo" />
            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden" asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Detalle de receta</h3>

                <label>Receta</label>
                <select class="form-control"
                        asp-for="@Model.Actual!.receta"
                        asp-items="@Model.OpcionesRecetas">
                    <option value="0">-- Seleccione --</option>
                </select>
                <br />
                <label>Medicamento</label>
                <select class="form-control"
                        asp-for="@Model.Actual!.medicamento"
                        asp-items="@Model.OpcionesMedicamentos">
                    <option value="0">-- Seleccione --</option>
                </select>
                <br />
                <label>Cantidad</label>
                <input asp-for="@Model.Actual!.cantidad" class="form-control" type="number" min="1" />
                <br />

            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>
                    <h4>¿Quiere borrar @Model.NombreMedicamentos(Model.Actual?.medicamento) de la receta #@Model.Actual?.receta?</h4>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br /><br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Receta</th>
                        <th>Medicamento</th>
                        <th>Cantidad</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@Model.NombreRecetas(elemento.receta)</td>
                                <td>@Model.NombreMedicamentos(elemento.medicamento)</td>
                                <td>@elemento.cantidad</td>
                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }
    </div>
</form>
