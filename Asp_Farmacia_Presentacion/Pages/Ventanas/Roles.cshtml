@page
@model RolesModel
@{
    ViewData["Title"] = "Roles";
}
<form method="post" enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Roles</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />
            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo" />
            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden" asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Rol</h3>

                <label>Nombre</label>
                <input asp-for="@Model.Actual!.nombre" class="form-control" />
                <br />

            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>
                    <h4>¿Quiere borrar el rol: @Model.Actual?.nombre?</h4>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br /><br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Id</th>
                        <th>Nombre</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.Id</td>
                                <td>@elemento.nombre</td>
                                <td>
                                    @if (Model.EsRolDelSistema(elemento.nombre))
                                    {
                                        <span class="text-muted">Rol del sistema</span>
                                    }
                                    else
                                    {
                                        <input type="submit"
                                               value="Editar"
                                               class="btn btn-secondary"
                                               asp-page-handler="BtEditar"
                                               asp-route-data="@elemento.Id" />
                                        <input type="submit"
                                               value="Borrar"
                                               class="btn btn-secondary"
                                               asp-page-handler="BtPregBorrar"
                                               asp-route-data="@elemento.Id" />
                                    }
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }
    </div>
</form>
