@page
@model SucursalesModel
@{
    ViewData["Title"] = "Sucursales";
}
<form method="post" enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Sucursales</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />
            <input type="submit"
                   value="Nueva Sucursal"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo" />
            <input type="submit"
                   value="Guardar Sucursal"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden" asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Sucursal</h3>

                <label>Nombre</label>
                <input asp-for="@Model.Actual!.nombre" class="form-control" />
                <br />

                <label>Dirección</label>
                <input asp-for="@Model.Actual!.direccion" class="form-control" />
                <br />

                <label>Teléfono</label>
                <input asp-for="@Model.Actual!.telefono" class="form-control" />
                <br />

                <label>Activo</label>
                <input type="checkbox" asp-for="@Model.Actual!.activo" />
                <br />
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>
                    <h4>¿Quiere borrar la sucursal: @Model.Actual!.nombre?</h4>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br /><br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Nombre</th>
                        <th>Dirección</th>
                        <th>Teléfono</th>
                        <th>Activo</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento.nombre</td>
                                <td>@elemento.direccion</td>
                                <td>@elemento.telefono</td>
                                <td>@(elemento.activo ? "Sí" : "No")</td>
                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }
    </div>
</form>
