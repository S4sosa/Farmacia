@page
@model DetallesComprasModel
@{
    ViewData["Title"] = "Detalles de Compras";
}
<form method="post" enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Detalles de Compras</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />
            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo" />
            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden" asp-for="@Model.Actual!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Detalle de compra</h3>

                <label>Compra</label>
                <select class="form-control"
                        asp-for="@Model.Actual!.compra"
                        asp-items="@Model.OpcionesCompras">
                    <option value="0">-- Seleccione --</option>
                </select>
                <br />
                <label>Producto</label>
                <select class="form-control"
                        asp-for="@Model.Actual!.producto"
                        asp-items="@Model.OpcionesProductos">
                    <option value="0">-- Seleccione --</option>
                </select>
                <br />
                <label>Cantidad</label>
                <input asp-for="@Model.Actual!.cantidad" class="form-control" type="number" min="1" />
                <br />
                <label>Precio unitario</label>
                <input asp-for="@Model.Actual!.precio" class="form-control" />
                <br />

            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>
                    <h4>¿Quiere borrar el detalle de @Model.NombreProductos(Model.Actual?.producto) de la compra #@Model.Actual?.compra?</h4>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br /><br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Compra</th>
                        <th>Producto</th>
                        <th>Cantidad</th>
                        <th>Precio</th>
                        <th>Subtotal</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@Model.NombreCompras(elemento.compra)</td>
                                <td>@Model.NombreProductos(elemento.producto)</td>
                                <td>@elemento.cantidad</td>
                                <td>@elemento.precio.ToString("C")</td>
                                <td>@((elemento.precio * elemento.cantidad).ToString("C"))</td>
                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }
    </div>
</form>
