@page
@model ProductosModel
@{
    ViewData["Title"] = "Productos";
}
<form method="post" enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Productos disponibles</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />
            <input placeholder="Buscar por nombre"
                   asp-for="@Model.Filtro!.nombre" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }

        <br /><br />
        <div class="containers_vn panel panel-default">
            <table class="tb_data table table-striped table-bordered table-hover">
                <tr>
                    <th>Nombre</th>
                    <th>Categoría</th>
                    <th>Imagen</th>
                    <th>Precio</th>
                    <th>Cantidad</th>
                    <th>Acción</th>
                </tr>
                @if (Model != null && Model.Lista != null)
                {
                    foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>@elemento.nombre</td>
                            <td>@elemento._categoria!.nombre</td>
                            <td> @*Este es el campo de la imagen*@
                                @if (!string.IsNullOrEmpty(elemento.imagen))
                                {
                                    <img src="~/imagenes/@elemento.imagen"
                                         alt="Imagen de @elemento.nombre"
                                         style="width:80px;
                                    height:80px;
                                    object-fit:cover;
                                    border-radius:5px;" />
                                }
                                else
                                {
                                    <span>Sin imagen</span>
                                }
                            </td>
                            <td>@elemento.precio.ToString("C")</td>
                            <td>
                                <input type="number" min="1" value="1"
                                    name="cantidad_@elemento.Id"
                                    class="form-control" style="width:90px; margin:auto" />
                            </td>
                            <td>
                                <input type="submit"
                                    value="Comprar"
                                    class="btn btn-secondary"
                                    asp-page-handler="BtComprar"
                                    asp-route-data="@elemento.Id" />
                            </td>
                        </tr>
                    }
                }
            </table>
        </div>
    </div>
</form>
