@page
@model PersonalModel
@{
    ViewData["Title"] = "Personal";
}
<form method="post" enctype="multipart/form-data">

    <div class="text-center">
        <h1 class="display-4">Personal</h1>
        <div>
            <input type="submit"
                   value="Consultar"
                   class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />
            <input type="submit"
                   value="Nuevo"
                   class="btn btn-secondary"
                   asp-page-handler="BtNuevo" />
            <input type="submit"
                   value="Guardar"
                   class="btn btn-secondary"
                   asp-page-handler="BtGuardar" />
        </div>

        @if (ViewData.ContainsKey("Mensaje"))
        {
            @await Html.PartialAsync("../Emergentes/Mensajes.cshtml");
        }

        @if (Model.Formulario || Model.Borrar)
        {
            <input type="hidden" asp-for="@Model.ActualPersona!.Id" />
            <input type="hidden" asp-for="@Model.ActualEmpleado!.Id" />
        }

        @if (Model.Formulario)
        {
            <div>
                <h3>Persona</h3>

                <label>Nombre</label>
                <input asp-for="@Model.ActualPersona!.nombre" class="form-control" />
                <br />

                <label>Apellidos</label>
                <input asp-for="@Model.ActualPersona!.apellidos" class="form-control" />
                <br />

                <label>Documento</label>
                <input asp-for="@Model.ActualPersona!.documento" class="form-control" />
                <br />

                <label>Teléfono</label>
                <input asp-for="@Model.ActualPersona!.telefono" class="form-control" />
                <br />

                <h3>Empleado</h3>

                <label>Cargo</label>
                <select class="form-control"
                        asp-for="@Model.ActualEmpleado!.cargo"
                        asp-items="@(new SelectList(Model.Cargos, "Id", "nombre"))">
                </select>
                <br />
            </div>
        }

        @if (Model.Borrar)
        {
            <div class="popup">
                <div class="pp_del_inner">
                    <h3>Mensaje</h3>
                    <h4>¿Quiere borrar el empleado: @Model.ActualPersona!.nombre @Model.ActualPersona!.apellidos?</h4>
                    <input type="submit"
                           value="Cancelar"
                           class="btn btn-secondary"
                           asp-page-handler="BtConsultar" />
                    <input type="submit"
                           value="Borrar"
                           class="btn btn-secondary"
                           asp-page-handler="BtBorrar" />
                </div>
            </div>
        }

        @if (!Model.Formulario)
        {
            <br /><br />
            <div class="containers_vn panel panel-default">
                <table class="tb_data table table-striped table-bordered table-hover">
                    <tr>
                        <th>Nombre</th>
                        <th>Apellidos</th>
                        <th>Documento</th>
                        <th>Teléfono</th>
                        <th>Cargo</th>
                        <th>Acción</th>
                    </tr>
                    @if (Model != null && Model.Lista != null)
                    {
                        foreach (var elemento in Model.Lista)
                        {
                            <tr>
                                <td>@elemento._persona!.nombre</td>
                                <td>@elemento._persona!.apellidos</td>
                                <td>@elemento._persona!.documento</td>
                                <td>@elemento._persona!.telefono</td>
                                <td>@elemento._cargo!.nombre</td>
                                <td>
                                    <input type="submit"
                                           value="Editar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtEditar"
                                           asp-route-data="@elemento.Id" />
                                    <input type="submit"
                                           value="Borrar"
                                           class="btn btn-secondary"
                                           asp-page-handler="BtPregBorrar"
                                           asp-route-data="@elemento.Id" />
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>
        }
    </div>
</form>
